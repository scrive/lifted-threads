cabal-version:      3.0
name:               lifted-threads
version:            1.0
synopsis:           lifted IO operations from the threads library
description:
  @lifted-threads@ exports IO operations from the threads
  library lifted to any instance of 'MonadBase'
  or 'MonadBaseControl'.

homepage:           https://github.com/scrive/lifted-threads
license:            BSD-3-Clause
license-file:       LICENSE
author:             Scrive AB
maintainer:
  Andrzej Rybczak <andrzej@rybczak.net>,
  Jonathan Jouty <jonathan@scrive.com>

copyright:          Scrive AB
category:           Concurrency
build-type:         Simple
tested-with:        GHC == { 8.10.7, 9.0.2, 9.2.8, 9.4.8, 9.6.7, 9.8.4, 9.10.2, 9.12.2, 9.14.1 }

extra-source-files: README.md

source-repository head
  type:     git
  location: https://github.com/scrive/lifted-threads.git

library
  exposed-modules:
    Control.Concurrent.Thread.Group.Lifted
    Control.Concurrent.Thread.Lifted

  build-depends:
    , base               >=4.14 && <5
    , monad-control      >=0.3  && <1.1
    , threads            >=0.5  && <0.6
    , transformers-base  >=0.4  && <0.5

  hs-source-dirs:   src
  ghc-options:      -Wall
  default-language: Haskell2010
